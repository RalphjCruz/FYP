NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5433/myslime
JWT_SECRET=replace-with-a-strong-local-dev-secret
JWT_EXPIRES_IN=30m
RATE_LIMIT_SECRET=replace-with-a-strong-rate-limit-secret
LOGIN_RATE_LIMIT_PER_WINDOW=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
FOCUS_MIN_DURATION_MINUTES=5
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_PURGE_BATCH_SIZE=100
ACCOUNT_EXPORT_RATE_LIMIT_PER_WINDOW=1
ACCOUNT_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost
