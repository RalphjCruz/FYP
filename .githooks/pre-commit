#!/usr/bin/env sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

# Block committing local env files
env_like_files="$(printf '%s\n' "$staged_files" | grep -E '(^|/)\.env(\..*)?$' || true)"
blocked_env_files="$(printf '%s\n' "$env_like_files" | grep -Ev '(^|/)\.env\.example$' || true)"

if [ -n "$blocked_env_files" ]; then
  echo "Commit blocked: .env files are not allowed in git."
  echo "Allowed exception: .env.example"
  echo "Blocked file(s):"
  printf '%s\n' "$blocked_env_files"
  echo "Unstage with: git restore --staged <file>"
  exit 1
fi

# Block committing private key/cert files
if printf '%s\n' "$staged_files" | grep -Eiq '(^|/).*\.(pem|key|crt)$'; then
  echo "Commit blocked: private key/cert files are not allowed in git."
  echo "Unstage with: git restore --staged <file>"
  exit 1
fi

exit 0
